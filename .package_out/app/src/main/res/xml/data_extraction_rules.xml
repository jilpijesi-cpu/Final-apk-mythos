<?xml version="1.0" encoding="utf-8"?>
<!--
    Aturan ekstraksi data (Android 12+). Aplikasi ini menyimpan kunci API, riwayat chat, dan berangkas,
    jadi TIDAK ada data yang boleh ikut cadangan cloud maupun transfer perangkat.
    Selaras dengan android:allowBackup="false" di manifest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
